        "url": "{{baseUrl}}/api/insights",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"A café recommendation for every city.\",\n  \"categorySlugs\": [\n    \"food\"\n  ],\n  \"citySlugs\": []\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"generalId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 — Browse Tokyo — excludes General",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
