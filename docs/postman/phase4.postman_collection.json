{
  "info": {
    "name": "Atlas — Phase 4 local review",
    "description": "Run requests in order against your local atlas_dev API. The first request initializes unique user emails. Auth cookies are handled by Postman. Expected 400/401/403/404 responses are deliberate checks. Final requests delete the two insights; test accounts and reusable place rows remain. No Google calls. See docs/postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "origin",
      "value": "http://localhost:5173",
      "type": "string"
    },
    {
      "key": "password",
      "value": "postman-local-test-password",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "authorEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "readerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "insightId",
      "value": "",
      "type": "string"
    },
    {
      "key": "generalId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Health + initialize a new run",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = Date.now().toString();",
              "pm.collectionVariables.set(\"runId\", runId);",
              "pm.collectionVariables.set(\"authorEmail\", \"postman-author-\" + runId + \"@minerva.edu\");",
              "pm.collectionVariables.set(\"readerEmail\", \"postman-reader-\" + runId + \"@uni.minerva.edu\");",
              "pm.collectionVariables.unset(\"insightId\");",
              "pm.collectionVariables.unset(\"generalId\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 — Sign up author",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/sign-up/email",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Author\",\n  \"email\": \"{{authorEmail}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 — Cities",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{baseUrl}}/api/cities"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().map(x => x.slug)).to.include(\"tokyo\").and.not.include(\"general\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 — Categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{baseUrl}}/api/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().map(x => x.slug)).to.include(\"food\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 — Create Tokyo insight",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/insights",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman café {{runId}}\",\n  \"body\": \"A café recommendation in Tokyo.\",\n  \"categorySlugs\": [\n    \"food\",\n    \"travel\"\n  ],\n  \"citySlugs\": [\n    \"tokyo\"\n  ],\n  \"sourceUrl\": \"https://example.com\",\n  \"places\": [\n    {\n      \"googlePlaceId\": \"postman-place-a-{{runId}}\"\n    },\n    {\n      \"googlePlaceId\": \"postman-place-b-{{runId}}\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"insightId\", pm.response.json().id);",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().isAuthor).to.eql(true); pm.expect(pm.response.json().places).to.have.length(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 — Create General insight",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
