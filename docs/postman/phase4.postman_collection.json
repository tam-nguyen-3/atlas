          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Uncached response\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"));",
              "pm.test(\"Expected behavior\", () => { pm.expect(pm.response.json().total).to.eql(1); pm.expect(pm.response.json().items[0].id).to.eql(pm.collectionVariables.get(\"insightId\")); pm.expect(pm.response.json().items[0]).not.to.have.property(\"body\"); });"
            ]
          }
        }
      ]
    },
