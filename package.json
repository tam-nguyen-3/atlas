{
  "name": "atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "smoke:api": "pnpm --filter @atlas/shared build && pnpm --filter @atlas/api smoke",
    "lint": "tsc -b && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "pnpm -r run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @atlas/api db:generate",
    "db:migrate": "pnpm --filter @atlas/api db:migrate",
    "db:seed": "pnpm --filter @atlas/api db:seed",
    "db:seed:test": "pnpm --filter @atlas/api db:seed:test",
    "dev:api": "pnpm --filter @atlas/shared build && pnpm --filter @atlas/api dev",
    "start:api": "pnpm --filter @atlas/api start"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
