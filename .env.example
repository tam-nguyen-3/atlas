# Copy to .env for local development. Never commit real values.
# The database URLs below match docker-compose.yml and work only locally.

# --- API runtime ---
NODE_ENV=development
# Port the API listens on.
PORT=3000

# --- Database ---
# Used by the API, migrations, and seeds.
DATABASE_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas_dev
# Used by tests. Must be a separate database.
TEST_DATABASE_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas_test

# --- Auth (Better Auth) ---
# Session signing secret. Generate a long random value for each environment.
BETTER_AUTH_SECRET=replace-me
# Public base URL of the API's auth routes.
BETTER_AUTH_URL=http://localhost:3000
# Browser origin allowed on state-changing routes.
WEB_ORIGIN=http://localhost:5173

# --- Google Places ---
# Browser key, restricted by site and API. Vite exposes this to the browser.
VITE_GOOGLE_MAPS_API_KEY=replace-me

# --- Seeded test user ---
# Test environments only. Never set these in production.
TEST_USER_EMAIL=test-user@minerva.edu
TEST_USER_PASSWORD=replace-me
