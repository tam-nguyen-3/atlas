# Copy to .env for local development. Never commit real values.
# The database URLs below match docker-compose.yml and work only locally.

# --- API runtime ---
NODE_ENV=development
# Port the API listens on.
PORT=3000

# --- Database ---
# Used by the API, migrations, and seeds.
DATABASE_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas_dev
# Used by tests and the test user seed. Its name must be atlas_test.
TEST_DATABASE_URL=postgres://atlas:atlas@127.0.0.1:5432/atlas_test

# --- Auth (Better Auth) ---
# Session signing secret (32+ characters). Generate one for each environment:
# openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me
# Public API origin, without a path or trailing slash. Production requires HTTPS.
# With the Vercel rewrite, this is the public website origin, not Render's URL.
BETTER_AUTH_URL=http://localhost:3000
# Exact browser origin allowed on state-changing routes (no trailing slash).
WEB_ORIGIN=http://localhost:5173

# --- Google Places ---
# Browser key, restricted by site and API. Vite exposes this to the browser.
VITE_GOOGLE_MAPS_API_KEY=replace-me

# --- Seeded test user ---
# Test environments only. Never set these in production.
TEST_USER_EMAIL=test-user@minerva.edu
TEST_USER_PASSWORD=replace-me
